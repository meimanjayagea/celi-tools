{
  "name": "celi-tools",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace=@celi/web",
    "dev:api": "npm run dev --workspace=@celi/api",
    "build": "npm run build --workspace=@celi/web",
    "start": "npm run start --workspace=@celi/web",
    "start:api": "npm run start --workspace=@celi/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=@celi/web",
    "test": "node --test tests/*.test.mjs",
    "test:files": "node scripts/run-file-tests.mjs",
    "test:api": "node scripts/test-file-api.mjs",
    "test:auth": "node scripts/test-auth-api.mjs",
    "check:css": "npm run check:css --workspace=@celi/web",
    "check:deployment": "node scripts/check-deployment.mjs"
  }
}
