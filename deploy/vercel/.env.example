# REFERENSI dashboard Vercel -> proyek web -> Environment Variables -> Production.
# File ini tidak dimuat otomatis. Masukkan nilai ke dashboard, lalu redeploy web.
# URL dan public key Supabase harus berasal dari proyek yang sama.
SUPABASE_URL=https://bklokpkgpbijgqidqmnv.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLIC_KEY
# Alternatif legacy jika belum memakai publishable key:
# SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_PUBLIC_ANON_KEY

# Ganti dengan domain HTTPS API Railway aktual, tanpa path /api/files.
FILE_API_URL=https://REPLACE-WITH-YOUR-API.up.railway.app

# Nilai di atas tetap publik karena dipakai browser, meskipun tanpa NEXT_PUBLIC_.
# Pilih Preview juga hanya jika domain preview sudah diizinkan oleh WEB_ORIGINS API.
# Google Client Secret, SMTP password, dan database password tidak diisi di sini.
