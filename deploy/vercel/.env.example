# Add these to the web Vercel project as server-only Environment Variables.
# Set AUTH_DATABASE_PROVIDER=none to deploy public features without auth/database.
# PostgreSQL services (including Supabase and Prisma Postgres) use the pg driver.
# From the repository root, run `npm run db:migrate` before enabling database-backed auth.
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=https://your-web-domain.example
AUTH_DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://user:password@db.example:5432/celi_auth?sslmode=require

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM="Celi Tools <no-reply@your-verified-domain.example>"

# Secret acak minimal 32 byte yang sama untuk frontend dan API service.
FILE_API_SIGNING_SECRET=generate-separate-random-secret-at-least-32-bytes

# File service is routed on the same origin by the Vercel Services rewrites.
WEB_ORIGINS=https://your-web-domain.example
FILE_TOOLS_TRUST_PROXY=true
