# REFERENSI MANUAL konfigurasi Supabase Cloud dan Google Cloud, BUKAN env runtime.
# Aplikasi web/API tidak membaca variabel dalam file ini.
# Mengisi file ini atau mengimpornya ke Vercel/Railway TIDAK mengaktifkan provider.
# Salin NILAI masing-masing ke field dashboard yang dijelaskan di bawah.
# Jangan commit salinan berisi secret asli. Gunakan penyimpanan kredensial privat.

# Supabase -> Authentication -> Sign In / Providers -> Google:
# Enable Google = ON, Client IDs = GOOGLE_CLIENT_ID, Client Secret = GOOGLE_CLIENT_SECRET.
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET

# Google Cloud -> OAuth client tipe Web application -> Authorized JavaScript origins.
# Masukkan setiap origin sebagai entri terpisah; pisahkan lokal/production sesuai kebutuhan.
GOOGLE_AUTHORIZED_ORIGINS=https://web-tau-ivory-11.vercel.app,http://localhost:3000
# Google Cloud -> OAuth client -> Authorized redirect URIs:
GOOGLE_REDIRECT_URI=https://bklokpkgpbijgqidqmnv.supabase.co/auth/v1/callback
# Google Auth Platform -> Data Access: hanya identitas/email/profil untuk login ini.
GOOGLE_OAUTH_SCOPES=openid,email,profile

# Supabase -> Authentication -> URL Configuration -> Site URL:
SUPABASE_SITE_URL=https://web-tau-ivory-11.vercel.app
# Redirect URLs: setiap URL berikut menjadi entri terpisah di dashboard.
SUPABASE_REDIRECT_URLS=https://web-tau-ivory-11.vercel.app/auth/callback**,https://web-tau-ivory-11.vercel.app/auth/confirm**,http://localhost:3000/auth/callback**,http://localhost:3000/auth/confirm**

# Supabase -> Authentication -> Email/provider: enable Email dan izinkan signup
# jika registrasi pengguna baru memang dibutuhkan. Nilai berikut hanya referensi.
EMAIL_PROVIDER_ENABLED=true
NEW_USER_SIGNUP_ENABLED=true

# Supabase -> Authentication -> Email -> SMTP Settings -> Enable Custom SMTP.
# Ambil host/port/username/password dari penyedia SMTP Anda, bukan dari Google OAuth.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_YOUR_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_YOUR_SMTP_PASSWORD
SMTP_SENDER_EMAIL=no-reply@your-verified-domain.example
SMTP_SENDER_NAME="Celi Tools"
# Gunakan port/TLS yang ditentukan penyedia, serta alamat pengirim/domain terverifikasi.
# Template Magic Link/Confirm Signup ada di docs/AUTH.md.
