# REFERENSI dashboard Railway -> layanan API -> Variables.
# File ini tidak dimuat otomatis. Build context root; config /railway.json.
NODE_ENV=production
HOST=0.0.0.0
WEB_ORIGINS=https://web-tau-ivory-11.vercel.app,https://web-jayas-projects-97030461.vercel.app,https://web-git-main-jayas-projects-97030461.vercel.app
# Railway's trusted public ingress supplies the client address in X-Forwarded-For.
FILE_TOOLS_TRUST_PROXY=true
FILE_TOOLS_TRUSTED_PROXY_HOPS=1

# Railway menyediakan PORT. Isi hanya jika mengatur target port secara manual.
# PORT=3001
# Path berikut sudah diberikan oleh Dockerfile; tidak perlu diisi ulang.
# FILE_TOOLS_PYTHON=/opt/file-tools/bin/python
# FILE_TOOLS_OFFICE=/usr/bin/libreoffice
# FILE_TOOLS_RUNTIME_ROOT=/app/.file-tools
# Opsional hanya jika image menyediakan executable alternatif:
# FILE_TOOLS_FFMPEG=/path/to/ffmpeg

# API file ini tidak memerlukan kredensial autentikasi web atau DATABASE_URL.
