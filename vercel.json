{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "npm ci --prefix ../.. --include=dev",
      "buildCommand": "npm run build"
    },
    "backend": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.api"
    }
  },
  "rewrites": [
    { "source": "/api/files/capabilities", "destination": { "service": "backend" } },
    { "source": "/api/files/scan", "destination": { "service": "backend" } },
    { "source": "/api/files/convert", "destination": { "service": "backend" } },
    { "source": "/api/files/compress", "destination": { "service": "backend" } },
    { "source": "/api/files/delete", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/ready", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
