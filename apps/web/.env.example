# WEB LOKAL: salin ke apps/web/.env.local, kemudian isi nilai proyek Anda.
# Vercel production: lihat deploy/vercel/.env.example.
# Tiga nilai ini dibundel untuk browser oleh next.config.ts; bukan secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLIC_KEY
# Alternatif legacy: isi ANON key saja, bukan service_role.
# SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_PUBLIC_ANON_KEY
FILE_API_URL=http://localhost:3001
# Nama baru diprioritaskan; nama lama NEXT_PUBLIC_ tetap menjadi fallback.
# Restart dev / rebuild setelah mengganti nilai.
# Google OAuth dan SMTP diatur di Supabase, bukan environment aplikasi web.
# Referensi field: deploy/supabase/.env.example dan docs/ENVIRONMENT.md.
# DATABASE_URL tidak diperlukan oleh implementasi saat ini: web memakai Supabase Auth.
