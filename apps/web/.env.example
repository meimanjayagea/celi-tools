# Copy to apps/web/.env.local. Keep all authentication secrets server-side.
AUTH_SECRET=generate-a-random-secret-of-at-least-32-bytes
AUTH_URL=http://localhost:3000
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://celi_auth:replace-me@localhost:5432/celi_auth

# Wajib untuk file processing production di Vercel. Set nilai yang sama pada service API.
# FILE_API_SIGNING_SECRET=generate-a-separate-random-secret-at-least-32-bytes

# Required Google OAuth web client credentials (not an API key).
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
