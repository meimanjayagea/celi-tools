# API LOKAL: salin ke apps/api/.env. Runner API memuat file ini.
# Railway production: gunakan deploy/railway/.env.example.
PORT=3001
HOST=127.0.0.1
WEB_ORIGINS=http://localhost:3000
# Enable only when every request reaches this API through a trusted proxy that appends X-Forwarded-For.
FILE_TOOLS_TRUST_PROXY=false
FILE_TOOLS_TRUSTED_PROXY_HOPS=1
# Beberapa origin boleh dipisahkan koma, tanpa path atau wildcard.
# WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Override opsional executable lokal; default Python ada di root .file-tools/venv.
# FILE_TOOLS_PYTHON=C:/path/to/python.exe
# FILE_TOOLS_OFFICE=C:/path/to/soffice.exe
# FILE_TOOLS_FFMPEG=C:/path/to/ffmpeg.exe
# FILE_TOOLS_RUNTIME_ROOT=C:/path/to/.file-tools
# Backend file tidak memerlukan kredensial autentikasi web, SMTP, atau database.
